# Template only: copy to .env and fill in there. Never put real values in this file.

PORT=9091
DATABASE_URL=

# Same value as WORKER_SECRET in the primary backend
WORKER_SECRET=

# Main model: any OpenAI-compatible chat API. NVIDIA's free Qwen3 Coder (key from build.nvidia.com) shown here.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=qwen/qwen3-coder-480b-a35b-instruct

# Used when the main model is busy, rate-limited or gone. On another provider, an overload at one
# doesn't stop builds. Leave the base URL and key empty to use the main provider's.
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gemini-3.5-flash

# Longest reply, in tokens, for both models. A whole app needs a lot; too low and replies stop partway.
# Must be within both providers' limits (Gemini: about 65000).
LLM_MAX_TOKENS=32000
# Optional: seconds to wait for a model to start answering before trying again, then the fallback (default 120)
# LLM_TIMEOUT_SECONDS=120
