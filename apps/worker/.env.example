# Template only: copy to .env and fill in there. Never put real values in this file.

PORT=9091
DATABASE_URL=

# Same value as WORKER_SECRET in the primary backend
WORKER_SECRET=

# Any OpenAI-compatible chat API. Gemini (key from aistudio.google.com) shown here.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
# Used when LLM_MODEL is overloaded or rate-limited. An established model is less likely to be busy.
LLM_FALLBACK_MODEL=gemini-2.5-flash
# Longest reply, in tokens. A whole app needs a lot; too low and replies stop partway through.
LLM_MAX_TOKENS=32000
# DeepSeek instead: LLM_BASE_URL=https://api.deepseek.com and LLM_MODEL=deepseek-v4-pro
