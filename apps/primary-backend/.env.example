# Template only: copy to .env and fill in there. Never put real values in this file.

PORT=9090
DATABASE_URL=

# Clerk's JWT public key (Clerk dashboard -> API keys -> JWT public key), PEM format
JWT_PUBLIC_KEY=

# The deployed frontend, for CORS. Several allowed, comma separated: https://ndstill.com,https://www.ndstill.com
FRONTEND_URL=http://localhost:3000

# On the control server: http://orchestrator:9092
ORCHESTRATOR_URL=http://localhost:9092
# Same value as in the orchestrator. Generate with: openssl rand -hex 32
ORCHESTRATOR_SECRET=
# Same value as in the worker. A different value from ORCHESTRATOR_SECRET.
WORKER_SECRET=

# "private" when running inside the VPC, "public" when running on your laptop
WORKER_ADDRESS=private

# The router in front of the editors. Leave both empty on your laptop.
# CODE_URL=https://code.ndstill.com
CODE_URL=
# Generate with: openssl rand -hex 32
ROUTER_SECRET=
