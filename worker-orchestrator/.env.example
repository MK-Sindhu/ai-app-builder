# Copy to .env and fill in. Never commit .env.

PORT=9092
AWS_REGION=eu-north-1
ASG_NAME=vscode-asg

# Only needed when running on your laptop. On AWS, attach an IAM role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Same value as ORCHESTRATOR_SECRET in the primary backend. Generate with: openssl rand -hex 32
ORCHESTRATOR_SECRET=

# "private" when running inside the VPC, "public" when running on your laptop
WORKER_ADDRESS=private

# Optional: terminate a project's machine after its page has been closed this many minutes.
# Saves money, but the project's files are lost with the machine. Leave empty to keep machines.
IDLE_TIMEOUT_MINUTES=10
